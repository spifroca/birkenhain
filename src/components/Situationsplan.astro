---
import Picture from './Picture.astro';
import PlanFigur from './PlanFigur.astro';
import detail from '../data/baubereiche-detail.json';
import type { ImageMetadata } from 'astro';
import { getCollection } from 'astro:content';
import { pathFor, type Locale } from '../i18n/routes';
import { pick, useTranslations } from '../i18n/ui';

interface Props {
  locale: Locale;
  /** Planbild. Fehlt es, bleibt die Liste der Baubereiche als Zugang. */
  plan?: ImageMetadata;
  planAlt?: string;
  heading?: string;
  /** Die Ortslabels auf dem Plan nur dort zeigen, wo der Plan gross ist. */
  plates?: boolean;
}

const { locale, plan, planAlt, heading, plates = true } = Astro.props;
const t = useTranslations(locale);

type Detail = { ausrichtung: Record<Locale, string>; nutzung: Record<Locale, string>; lage: Record<Locale, string> };
const details = detail as Record<string, Detail>;

const areas = (await getCollection('baubereiche')).sort((a, b) => a.id.localeCompare(b.id));

// Der Buchstabe im Hauscode traegt die Zielgruppe: D, F, B — Haus 17 ohne
// Buchstaben zaehlt zu den Familienhaeusern.
function typ(label: string): 'd' | 'f' | 'b' {
  if (label.endsWith('D')) return 'd';
  if (label.endsWith('B')) return 'b';
  return 'f';
}

const zielgruppe = { d: t('architektur.zgD'), f: t('architektur.zgF'), b: t('architektur.zgB') };

const markers = areas.filter((area) => area.data.plan.x !== null && area.data.plan.y !== null);

function markerLabel(area: (typeof areas)[number]): string {
  return area.data.vollgeschosse === null
    ? t('situationsplan.markerPending', { label: area.data.label })
    : t('situationsplan.marker', { label: area.data.label, floors: area.data.vollgeschosse });
}
---

<section class="plan section--alt section--m" aria-labelledby="plan-heading">
  <div class="container">
    <div class="titlerow">
      <h2 id="plan-heading">{heading ?? t('home.situationsplanHeading')}</h2>
      <p class="credit">{t('home.situationsplanHint')}</p>
    </div>

    <div class="plan__layout">
      <PlanFigur ratio="1464 / 1069" class="plan__figure">
        {
          plan ? (
            <Picture src={plan} alt={planAlt ?? t('situationsplan.label')} sizes="(min-width: 68rem) 60vw, 100vw" />
          ) : (
            <p class="plan__placeholder">{t('architektur.pendingData')}</p>
          )
        }

        {
          plates && (
            <>
              <span class="plate plate--water" style="left: 57%; top: 8.5%">
                {t('architektur.plateNaturpool')}
              </span>
              <span class="plate plate--accent" style="left: 45%; top: 49.5%; max-width: 11%">
                {t('architektur.platePlatz')}
              </span>
              <span class="plate plate--forest" style="left: 2.5%; top: 2%">
                {t('architektur.plateWald')}
              </span>
            </>
          )
        }

        {
          markers.map((area) => (
            <button
              class="marker"
              type="button"
              data-area={area.id}
              data-typ={typ(area.data.label)}
              style={`--x: ${area.data.plan.x}%; --y: ${area.data.plan.y}%; --vg: ${area.data.vollgeschosse ?? 3}`}
              aria-label={markerLabel(area)}
              aria-pressed="false"
              aria-controls="plan-detail"
            >
              <span aria-hidden="true">{area.data.label}</span>
            </button>
          ))
        }
      </PlanFigur>

      <div class="plan__side">
        <div class="panel" id="plan-detail" aria-live="polite">
          {
            areas.map((area, index) => {
              const d = details[area.data.label];
              return (
                <article class="panel__card" data-detail={area.id} hidden={index !== 0}>
                  <p class="panel__eyebrow">{t('architektur.tableArea')}</p>
                  <p class="panel__id">{area.data.label}</p>

                  <dl class="rows rows--panel">
                    <div class="row">
                      <dt class="row__label">{t('architektur.tableFloors')}</dt>
                      <dd class="row__strong">
                        {area.data.vollgeschosse ?? <span class="panel__pending">—</span>}
                      </dd>
                    </div>
                    <div class="row">
                      <dt class="row__label">{t('architektur.panelUnits')}</dt>
                      <dd class="row__strong">
                        {area.data.wohnungen ?? <span class="panel__pending">—</span>}
                      </dd>
                    </div>
                    {d && (
                      <>
                        <div class="row">
                          <dt class="row__label">{t('architektur.panelOrientation')}</dt>
                          <dd class="row__strong">{d.ausrichtung[locale]}</dd>
                        </div>
                        <div class="row">
                          <dt class="row__label">{t('architektur.panelUse')}</dt>
                          <dd class="row__strong">{d.nutzung[locale]}</dd>
                        </div>
                      </>
                    )}
                    <div class="row">
                      <dt class="row__label">{t('architektur.panelTarget')}</dt>
                      <dd class="row__strong">{zielgruppe[typ(area.data.label)]}</dd>
                    </div>
                  </dl>

                  {pick(area.data.text, locale) && <p class="panel__text">{pick(area.data.text, locale)}</p>}

                  <a class="btn btn--primary btn--block panel__cta" href={pathFor('wohnungen', locale)}>
                    {t('architektur.panelCta')}
                  </a>
                </article>
              );
            })
          }
        </div>

        <ul class="legend">
          <li><span class="legend__swatch" data-typ="d"></span>{t('architektur.legendD')}</li>
          <li><span class="legend__swatch" data-typ="f"></span>{t('architektur.legendF')}</li>
          <li><span class="legend__swatch" data-typ="b"></span>{t('architektur.legendB')}</li>
        </ul>

        <p class="plan__note">{t('architektur.planNote')}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .plan__layout {
    display: grid;
    gap: var(--grid-gap-tight);
    grid-template-columns: 1fr;
  }

  .plan__placeholder {
    max-width: none;
    padding: var(--space-xl) var(--space-m);
    text-align: center;
    color: var(--c-text-muted);
    font-size: var(--fs-small);
  }

  /* --- Marker: Groesse nach Vollgeschossen, Farbe nach Zielgruppe -------- */

  .marker {
    position: absolute;
    top: var(--y);
    left: var(--x);
    display: grid;
    place-items: center;
    width: calc(1.5625rem + (var(--vg) - 3) * 0.1625rem);
    height: calc(1.5625rem + (var(--vg) - 3) * 0.1625rem);
    transform: translate(-50%, -50%);
    border: var(--border-width) solid rgb(51 49 47 / 0.55);
    border-radius: 50%;
    font-size: 0.59375rem;
    font-weight: var(--fw-medium);
    font-variant-numeric: tabular-nums;
    color: var(--c-text);
    transition:
      background-color var(--duration) var(--ease),
      box-shadow var(--duration) var(--ease);
  }

  .marker[data-typ='d'] { background: var(--c-typ-d); }
  .marker[data-typ='f'] { background: var(--c-typ-f); }
  .marker[data-typ='b'] { background: var(--c-typ-b); }

  .marker:hover {
    box-shadow: 0 0 0 3px rgb(74 90 68 / 0.18);
  }

  .marker[aria-pressed='true'] {
    z-index: 3;
    background: var(--c-accent);
    border-color: var(--c-accent);
    color: #fff;
    box-shadow: 0 0 0 5px rgb(74 90 68 / 0.22);
  }

  .plate--water { color: var(--c-plate-water); }
  .plate--forest { color: var(--c-plate-forest); }
  .plate--accent { color: var(--c-accent); }

  /* --- Seitenfeld -------------------------------------------------------- */

  .panel {
    border: var(--hairline);
    background: var(--c-bg);
    padding: 1.375rem 1.25rem 1.5rem;
  }

  .panel__card[hidden] {
    display: none;
  }

  .panel__eyebrow {
    margin: 0 0 var(--space-3xs);
    font-size: 0.6875rem;
    font-weight: var(--fw-bold);
    letter-spacing: var(--ls-caps-tight);
    text-transform: uppercase;
    color: var(--c-text-faint);
  }

  .panel__id {
    margin: 0;
    font-size: 2.5rem
    ;
    font-weight: var(--fw-extralight);
    line-height: 1;
    letter-spacing: var(--ls-heading);
    font-variant-numeric: tabular-nums;
  }

  .rows--panel {
    margin-top: var(--space-m);
    border-block: 0;
  }

  .rows--panel .row {
    padding-block: 0.625rem;
    /* Die Karte ist EINE Flaeche. `.section--alt .row` in design.css setzt
       jede Zeile auf --c-bg-alt, das Panel selbst steht auf --c-bg: das gab
       im fertigen Feld hellere Raender um beige Streifen, zwei Toene statt
       einem. `transparent` laesst die Zeilen die Farbe des Panels annehmen —
       auch dann noch, wenn die Panelfarbe einmal wechselt. Ein fester Wert
       waere hier eine zweite Wahrheit, die beim naechsten Umbau auseinander
       laeuft. */
    background: transparent;
  }

  .rows--panel dt,
  .rows--panel dd {
    margin: 0;
  }

  .row__strong {
    font-size: 0.875rem;
    font-weight: var(--fw-medium);
    text-align: right;
  }

  .rows--panel .row__label {
    font-size: 0.875rem;
    color: var(--c-text-muted);
  }

  .panel__pending {
    color: var(--c-text-faint);
  }

  .panel__text {
    max-width: none;
    margin: var(--space-s) 0 0;
    font-size: var(--fs-small);
    font-weight: var(--fw-light);
    line-height: var(--lh-body-tight);
    color: var(--c-text-muted);
  }

  .panel__cta {
    margin-top: var(--space-m);
  }

  /* --- Legende und Liste ------------------------------------------------- */

  .legend {
    display: grid;
    gap: 0.625rem;
    margin: var(--space-s) 0 0;
    padding: 0;
    list-style: none;
    font-size: var(--fs-small);
    font-weight: var(--fw-light);
    color: #54514d;
  }

  .legend li {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
  }

  .legend__swatch {
    flex: 0 0 1rem;
    height: 1rem;
    border: var(--border-width) solid rgb(51 49 47 / 0.45);
  }

  .legend__swatch[data-typ='d'] { background: var(--c-typ-d); }
  .legend__swatch[data-typ='f'] { background: var(--c-typ-f); }
  .legend__swatch[data-typ='b'] { background: var(--c-typ-b); }

  .plan__note {
    max-width: none;
    margin: var(--space-xs) 0 0;
    font-size: var(--fs-caption);
    font-weight: var(--fw-light);
    line-height: 1.5;
    color: var(--c-text-faint);
  }

  @media (min-width: 68rem) {
    .plan__layout {
      grid-template-columns: minmax(0, 1.65fr) minmax(15rem, 1fr);
      align-items: start;
      gap: clamp(1.5rem, 3vw, 3rem);
    }
  }
</style>

<script>
  const detail = document.getElementById('plan-detail');

  if (detail) {
    const triggers = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-area]'));
    const cards = Array.from(detail.querySelectorAll<HTMLElement>('[data-detail]'));

    const select = (id: string) => {
      cards.forEach((card) => {
        card.hidden = card.dataset.detail !== id;
      });
      triggers.forEach((trigger) => {
        trigger.setAttribute('aria-pressed', String(trigger.dataset.area === id));
      });
    };

    triggers.forEach((trigger) => {
      trigger.addEventListener('click', () => {
        const id = trigger.dataset.area;
        if (id) select(id);
      });
    });

    const first = cards.find((card) => !card.hidden)?.dataset.detail;
    if (first) select(first);
  }
</script>
