---
import Icon from './Icon.astro';
import { getCollection } from 'astro:content';
import { pick, useTranslations } from '../i18n/ui';
import type { Locale } from '../i18n/routes';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const items = (await getCollection('energie')).sort((a, b) => a.data.order - b.data.order);
---

{
  items.length > 0 && (
    <section class="energie" aria-labelledby="energie-heading">
      <div class="container">
        <h2 id="energie-heading">{t('nachhaltigkeit.energieHeading')}</h2>

        <ul class="energie__list">
          {
            items.map((item) => (
              <li class="energie__item">
                <Icon name={item.data.icon} size="1.5rem" />
                <div class="energie__body">
                  <h3>{pick(item.data.thema, locale)}</h3>
                  {item.data.kennwert && (
                    <p class="energie__value">
                      {item.data.kennwert}
                      {item.data.einheit && <span class="energie__unit"> {item.data.einheit}</span>}
                    </p>
                  )}
                  <p class="energie__note">{pick(item.data.erlaeuterung, locale)}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  )
}

<style>
  .energie {
    padding-block: var(--space-2xl);
  }

  .energie__list {
    display: grid;
    gap: 0;
    margin: var(--space-l) 0 0;
    padding: 0;
    list-style: none;
    border-top: var(--hairline);
  }

  .energie__item {
    display: grid;
    gap: var(--space-s);
    padding-block: var(--space-m);
    border-bottom: var(--hairline);
    grid-template-columns: auto 1fr;
    align-items: start;
  }

  .energie__body h3 {
    font-size: var(--fs-h3);
    font-weight: var(--fw-regular);
  }

  .energie__value {
    padding-top: var(--space-3xs);
    font-size: var(--fs-h2);
    font-weight: var(--fw-extralight);
    font-variant-numeric: tabular-nums;
  }

  .energie__unit {
    font-size: var(--fs-body);
    color: var(--c-text-muted);
  }

  .energie__note {
    padding-top: var(--space-2xs);
    font-size: var(--fs-small);
    color: var(--c-text-muted);
  }

  @media (min-width: 60rem) {
    .energie__item {
      grid-template-columns: auto 18rem 1fr;
    }

    .energie__body {
      display: grid;
      grid-column: 2 / -1;
      grid-template-columns: 18rem 1fr;
      gap: var(--space-m);
      align-items: baseline;
    }

    .energie__note {
      padding-top: 0;
      grid-column: 2;
      grid-row: 1 / span 2;
    }
  }
</style>
