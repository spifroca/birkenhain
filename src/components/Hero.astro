---
import Picture from './Picture.astro';
import type { ImageMetadata } from 'astro';
import { existsSync } from 'node:fs';
import { withBase } from '../i18n/routes';

interface Props {
  kicker?: string;
  title: string;
  lead?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  /**
   * Dateiname eines Films in `public/media/`, der im Bildband an die Stelle
   * des Bildes tritt. Fehlt die Datei, bleibt das Bild — wie bei den Logos
   * gilt: eine fehlende Datei darf den Build nicht kippen.
   */
  video?: string;
  /**
   * `band` legt Titel und Kicker ueber das Bild — der Auftritt der
   * Startseite. `text` setzt sie auf den Papier-Grund; das Bild folgt dann
   * als eigenes Band unter dem Text (Unterseiten).
   */
  variant?: 'band' | 'text';
  ctaHref?: string;
  ctaLabel?: string;
  cta2Href?: string;
  cta2Label?: string;
}

const {
  kicker,
  title,
  lead,
  image,
  imageAlt,
  video,
  variant = 'text',
  ctaHref,
  ctaLabel,
  cta2Href,
  cta2Label,
} = Astro.props;

const band = variant === 'band' && image !== undefined;

/**
 * Der Film laeuft nur, wenn er auch daliegt — fehlt die Datei, bleibt es
 * beim Bild. Das Bild liegt ohnehin immer darunter: es steht sofort da,
 * waehrend der Film noch laedt, es vertritt ihn ohne JavaScript, und es
 * bleibt stehen, wenn jemand weniger Bewegung eingestellt hat. Deshalb
 * braucht das `video` kein eigenes `poster` — die Unterlage ist das Poster.
 */
const videoSrc =
  band && video && existsSync(new URL(`../../public/media/${video}`, import.meta.url))
    ? withBase(`/media/${video}`)
    : null;
---

{
  band ? (
    <section class="hero hero--band">
      <Picture src={image!} alt={imageAlt ?? ''} hero sizes="100vw" class="hero__image" />
      {videoSrc && (
        <video class="hero__video" src={videoSrc} autoplay muted loop playsinline preload="auto" />
      )}
      <div class="hero__scrim" />
      <div class="hero__body container">
        {kicker && <p class="hero__kicker hero__kicker--inverse">{kicker}</p>}
        <h1 class="hero__title">{title}</h1>
        {
          (ctaLabel || cta2Label) && (
            <div class="hero__actions">
              {ctaLabel && ctaHref && (
                <a class="btn btn--primary" href={ctaHref}>
                  {ctaLabel}
                </a>
              )}
              {cta2Label && cta2Href && (
                <a class="btn btn--glass" href={cta2Href}>
                  {cta2Label}
                </a>
              )}
            </div>
          )
        }
      </div>
    </section>
  ) : (
    <section class="hero">
      <div class="hero__text container">
        {kicker && <p class="hero__kicker">{kicker}</p>}
        <h1>{title}</h1>
        {lead && <p class="hero__lead">{lead}</p>}
      </div>
    </section>
  )
}

<script>
  // Kein `is:inline`: die CSP erlaubt nur `script-src 'self'`, ein
  // Inline-Skript wuerde blockiert. Astro buendelt dieses hier in eine
  // eigene Datei — wie bei Lightbox und Situationsplan.
  const film = document.querySelector<HTMLVideoElement>('.hero__video');

  if (film) {
    // Ruhiger als aufgenommen: der Film traegt Stimmung, nicht Handlung.
    // Nach jedem Neustart der Schleife erneut setzen — manche Engine faellt
    // sonst auf Normaltempo zurueck.
    const langsam = () => {
      film.playbackRate = 0.6;
    };

    langsam();
    film.addEventListener('play', langsam);
    film.addEventListener('loadeddata', langsam);

    // Weniger Bewegung: das Bild darunter bleibt stehen, der Film haelt an
    // und laedt nicht weiter. `display: none` allein wuerde ihn weiterladen.
    const ruhe = window.matchMedia('(prefers-reduced-motion: reduce)');

    const pruefen = () => {
      if (!ruhe.matches) return;
      film.autoplay = false;
      film.pause();
      film.removeAttribute('src');
      film.load();
    };

    pruefen();
    ruhe.addEventListener('change', pruefen);
  }
</script>

<style>
  .hero {
    padding-top: clamp(3rem, 7vw, 6rem);
  }

  .hero__text {
    padding-bottom: clamp(2.5rem, 5vw, 4.5rem);
  }

  /* Kicker: die Zeile ueber dem Titel. Eigene Klasse, nicht .eyebrow —
     die traegt auch Footer-Spalten und Formular-Legenden und soll leise
     bleiben statt bronzefarben. */
  .hero__kicker {
    display: block;
    margin-bottom: var(--space-m);
    font-size: var(--fs-caption);
    font-weight: var(--fw-bold);
    letter-spacing: var(--ls-caps);
    text-transform: uppercase;
    color: var(--c-accent);
  }

  .hero h1 {
    max-width: 18em;
  }

  .hero__lead {
    padding-top: var(--space-m);
    font-size: var(--fs-lead);
    font-weight: var(--fw-light);
    line-height: var(--lh-lead);
    color: #54514d;
  }

  /* --- Bildband-Variante -------------------------------------------------- */

  .hero--band {
    position: relative;
    height: var(--band-h-hero);
    min-height: 32.5rem;
    padding-top: 0;
    overflow: hidden;
    background: var(--c-bg-inverse);
  }

  .hero--band :global(.hero__image),
  .hero--band :global(.hero__image img),
  .hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Laeuft die Parallaxe, braucht das Bild Ueberlaenge nach unten: es wandert
     um 8 % der Bandhoehe nach oben, und ohne diesen Vorrat risse unten eine
     Luecke auf. Das Attribut setzt parallax.ts — steht es nicht (kein
     JavaScript, `prefers-reduced-motion`), bleibt das Band unveraendert. */
  .hero--band[data-parallax] :global(.hero__image),
  .hero--band[data-parallax] :global(.hero__image img),
  .hero--band[data-parallax] .hero__video {
    height: 108%;
    will-change: transform;
  }

  /* Weniger Bewegung heisst: das Bild allein. Der Film wird zusaetzlich per
     Skript angehalten — `display: none` beendet den Download nicht. */
  @media (prefers-reduced-motion: reduce) {
    .hero__video {
      display: none;
    }
  }

  .hero__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgb(28 32 27 / 0.42) 0%,
      rgb(28 32 27 / 0.08) 42%,
      rgb(28 32 27 / 0.68) 100%
    );
  }

  .hero__body {
    position: absolute;
    inset: auto 0 0 0;
    padding-bottom: clamp(2.5rem, 6vh, 4.5rem);
  }

  .hero__kicker--inverse {
    color: var(--c-kicker-inverse);
  }

  .hero__title {
    max-width: 16em;
    margin: 0;
    font-size: var(--fs-display);
    font-weight: var(--fw-extralight);
    line-height: var(--lh-tight);
    letter-spacing: var(--ls-display);
    color: #fff;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
    margin-top: clamp(1.5rem, 3vw, 2.125rem);
  }
</style>
