---
import Picture from './Picture.astro';
import type { ImageMetadata } from 'astro';

interface Props {
  kicker?: string;
  title: string;
  lead?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  /**
   * `band` legt Titel und Kicker ueber das Bild — der Auftritt der
   * Startseite. `text` setzt sie auf den Papier-Grund; das Bild folgt dann
   * als eigenes Band unter dem Text (Unterseiten).
   */
  variant?: 'band' | 'text';
  ctaHref?: string;
  ctaLabel?: string;
  cta2Href?: string;
  cta2Label?: string;
}

const {
  kicker,
  title,
  lead,
  image,
  imageAlt,
  variant = 'text',
  ctaHref,
  ctaLabel,
  cta2Href,
  cta2Label,
} = Astro.props;

const band = variant === 'band' && image !== undefined;
---

{
  band ? (
    <section class="hero hero--band">
      <Picture src={image!} alt={imageAlt ?? ''} hero sizes="100vw" class="hero__image" />
      <div class="hero__scrim" />
      <div class="hero__body container">
        {kicker && <p class="hero__kicker hero__kicker--inverse">{kicker}</p>}
        <h1 class="hero__title">{title}</h1>
        {
          (ctaLabel || cta2Label) && (
            <div class="hero__actions">
              {ctaLabel && ctaHref && (
                <a class="btn btn--primary" href={ctaHref}>
                  {ctaLabel}
                </a>
              )}
              {cta2Label && cta2Href && (
                <a class="btn btn--glass" href={cta2Href}>
                  {cta2Label}
                </a>
              )}
            </div>
          )
        }
      </div>
    </section>
  ) : (
    <section class="hero">
      <div class="hero__text container">
        {kicker && <p class="hero__kicker">{kicker}</p>}
        <h1>{title}</h1>
        {lead && <p class="hero__lead">{lead}</p>}
      </div>
    </section>
  )
}

<style>
  .hero {
    padding-top: clamp(3rem, 7vw, 6rem);
  }

  .hero__text {
    padding-bottom: clamp(2.5rem, 5vw, 4.5rem);
  }

  /* Kicker: die Zeile ueber dem Titel. Eigene Klasse, nicht .eyebrow —
     die traegt auch Footer-Spalten und Formular-Legenden und soll leise
     bleiben statt bronzefarben. */
  .hero__kicker {
    display: block;
    margin-bottom: var(--space-m);
    font-size: var(--fs-caption);
    font-weight: var(--fw-bold);
    letter-spacing: var(--ls-caps);
    text-transform: uppercase;
    color: var(--c-accent);
  }

  .hero h1 {
    max-width: 18em;
  }

  .hero__lead {
    padding-top: var(--space-m);
    font-size: var(--fs-lead);
    font-weight: var(--fw-light);
    line-height: var(--lh-lead);
    color: #54514d;
  }

  /* --- Bildband-Variante -------------------------------------------------- */

  .hero--band {
    position: relative;
    height: var(--band-h-hero);
    min-height: 32.5rem;
    padding-top: 0;
    overflow: hidden;
    background: var(--c-bg-inverse);
  }

  .hero--band :global(.hero__image),
  .hero--band :global(.hero__image img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgb(28 32 27 / 0.42) 0%,
      rgb(28 32 27 / 0.08) 42%,
      rgb(28 32 27 / 0.68) 100%
    );
  }

  .hero__body {
    position: absolute;
    inset: auto 0 0 0;
    padding-bottom: clamp(2.5rem, 6vh, 4.5rem);
  }

  .hero__kicker--inverse {
    color: var(--c-kicker-inverse);
  }

  .hero__title {
    max-width: 16em;
    margin: 0;
    font-size: var(--fs-display);
    font-weight: var(--fw-extralight);
    line-height: var(--lh-tight);
    letter-spacing: var(--ls-display);
    color: #fff;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
    margin-top: clamp(1.5rem, 3vw, 2.125rem);
  }
</style>
