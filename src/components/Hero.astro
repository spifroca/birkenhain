---
import Picture from './Picture.astro';
import type { ImageMetadata } from 'astro';

interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  image?: ImageMetadata;
  imageAlt?: string;
}

const { eyebrow, title, lead, image, imageAlt } = Astro.props;
---

<section class="hero">
  <div class="hero__text container">
    {eyebrow && <p class="hero__kicker">{eyebrow}</p>}
    <h1>{title}</h1>
    {lead && <p class="hero__lead">{lead}</p>}
  </div>

  {
    image ? (
      <Picture src={image} alt={imageAlt ?? ''} hero sizes="100vw" ratio="16 / 9" />
    ) : (
      /* TODO(handoff): Hero-Bild aus assets/ einsetzen. */
      <div class="hero__placeholder container">
        <p>TODO(handoff): Hero-Bild fehlt.</p>
      </div>
    )
  }
</section>

<style>
  .hero {
    padding-top: var(--space-xl);
  }

  .hero__text {
    padding-bottom: var(--space-l);
  }

  /* Kicker: die Zeile ueber dem Titel. Eigene Klasse, nicht .eyebrow —
     die traegt auch Footer-Spalten, Formular-Legenden und das 404-Label,
     und die sollen leise bleiben statt bronzefarben. Werte aus den
     Design-Tokens, kein Literal. */
  .hero__kicker {
    display: block;
    margin-bottom: var(--space-s);
    font-size: var(--fs-caption);
    font-weight: var(--fw-bold);
    letter-spacing: var(--ls-caps);
    text-transform: uppercase;
    color: var(--c-accent);
  }

  .hero__lead {
    padding-top: var(--space-m);
    font-size: var(--fs-lead);
    font-weight: var(--fw-extralight);
    line-height: 1.45;
  }

  .hero__placeholder {
    padding-block: var(--space-2xl);
    border-block: var(--hairline);
    color: var(--c-text-muted);
    font-size: var(--fs-small);
    text-align: center;
  }
</style>
