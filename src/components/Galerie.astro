---
import Lightbox from './Lightbox.astro';
import Picture from './Picture.astro';
import type { LightboxImage } from '../lib/media';
import { getCollection } from 'astro:content';
import { pick, useTranslations } from '../i18n/ui';
import type { Locale } from '../i18n/routes';

interface Props {
  locale: Locale;
  heading?: string;
  /** Ohne Angabe werden alle Bilder gezeigt. */
  limit?: number;
}

const { locale, heading, limit } = Astro.props;
const t = useTranslations(locale);

const entries = (await getCollection('galerie')).sort((a, b) => a.data.order - b.data.order);
const shown = limit ? entries.slice(0, limit) : entries;

const images: LightboxImage[] = shown.map((entry) => ({
  id: entry.id,
  src: entry.data.src,
  alt: pick(entry.data.alt, locale),
  caption: pick(entry.data.caption, locale),
}));
---

{
  images.length > 0 && (
    <section class="galerie" aria-labelledby="galerie-heading">
      <div class="container">
        <div class="titlerow">
          <h2 id="galerie-heading">{heading ?? t('home.galerieHeading')}</h2>
          <p class="credit">{t('home.galerieCredit')}</p>
        </div>

        <ul class="galerie__grid" data-reveal data-stagger>
          {
            images.map((image, index) => (
              <li class="galerie__cell">
                <button
                  class="galerie__trigger"
                  type="button"
                  data-lb-open={index}
                  aria-label={t('lightbox.open', { caption: image.caption || image.alt })}
                >
                  <Picture
                    src={image.src}
                    alt={image.alt}
                    sizes="(min-width: 68rem) 25vw, (min-width: 45rem) 50vw, 100vw"
                    hero={shown[index]?.data.hero ?? false}
                    ratio="3 / 2"
                  />
                </button>
              </li>
            ))
          }
        </ul>

        <Lightbox images={images} locale={locale} />
      </div>
    </section>
  )
}

<style>
  /* Die Galerie ist ein Raster aus Bildern, keine Liste mit Legenden — die
     Bildlegende steht in der Lightbox. */
  .galerie {
    padding-block: clamp(3.5rem, 7vw, 6rem);
    border-top: var(--hairline);
  }

  .galerie__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13.75rem, 1fr));
    gap: var(--space-xs);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .galerie__trigger {
    display: block;
    width: 100%;
    background: var(--c-image-placeholder);
  }

  .galerie__trigger :global(img) {
    transition: opacity var(--duration) var(--ease);
  }

  .galerie__trigger:hover :global(img) {
    opacity: 0.88;
  }
</style>
