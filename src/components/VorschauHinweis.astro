---
import Icon from './Icon.astro';
import type { Locale } from '../i18n/routes';
import { useTranslations } from '../i18n/ui';
import { features } from '../lib/flags';

/**
 * Leiste ueber dem Header.
 *
 * Sie hing am selben Schalter wie robots.txt und das noindex und ist
 * inzwischen entfernt — `features.previewNotice` steht auf false. Die
 * Suchmaschinen-Sperre ist davon unberuehrt: `indexable` bleibt false,
 * also traegt jede Seite weiter noindex.
 *
 * In der statischen Vorschau erscheint die Leiste trotzdem. Dort ist der
 * Absende-Knopf des Formulars deaktiviert, und dieser Text ist die einzige
 * Stelle, die das erklaert — ohne ihn stuende dort ein toter Knopf ohne
 * Begruendung.
 */
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

{
  (features.previewNotice || features.staticPreview) && (
    <div class="vorschau" role="note">
      <p class="vorschau__inner container">
        <Icon name="info" />
        <span>
          <strong>{t('preview.label')}</strong> {t('preview.body')}
          {features.staticPreview && <> {t('preview.noForm')}</>}
        </span>
      </p>
    </div>
  )
}

<style>
  .vorschau {
    background: var(--c-bg-inverse);
    color: var(--c-text-inverse);
    border-bottom: var(--hairline-inverse);
  }

  .vorschau__inner {
    display: flex;
    align-items: baseline;
    gap: var(--space-2xs);
    max-width: var(--container);
    margin: 0 auto;
    padding-block: var(--space-2xs);
    font-size: var(--fs-caption);
    line-height: 1.5;
  }

  .vorschau__inner strong {
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-caps);
    text-transform: uppercase;
  }
</style>
