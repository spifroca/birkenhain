---
import { alternatePath, LOCALES, type Locale, type PageId } from '../i18n/routes';
import { useTranslations } from '../i18n/ui';

interface Props {
  page: PageId;
  locale: Locale;
}

const { page, locale } = Astro.props;
const t = useTranslations(locale);

/**
 * Beide Sprachen stehen im Kopf, in fester Reihenfolge DE dann EN — so
 * zeigt es der Entwurf. Die aktuelle ist kein Link, sondern eine Marke;
 * die andere traegt den Wechsel. Bei genau zwei Sprachen ist die nicht
 * aktive immer das Gegenstueck aus `alternatePath`.
 */
const other = alternatePath(page, locale);
const items = LOCALES.map((code) => ({
  code,
  current: code === locale,
}));
---

<p class="lang">
  {
    items.map((item) =>
      item.current ? (
        <span class="lang__item lang__item--current" aria-current="true">
          {item.code.toUpperCase()}
        </span>
      ) : (
        <a
          class="lang__item"
          href={other.path}
          hreflang={item.code}
          lang={item.code}
          rel="alternate"
        >
          <span class="visually-hidden">{t('common.languageSwitch')}</span>
          <span aria-hidden="true">{item.code.toUpperCase()}</span>
        </a>
      ),
    )
  }
</p>

<style>
  /* Keine eigene Trennlinie: `.header__aside` traegt bereits eine, und zwei
     Haarlinien nebeneinander lasen sich als Versehen. Den Abstand nach der
     Linie setzt das Umfeld, nicht dieser Schalter. */
  .lang {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3xs);
    margin: 0;
  }

  .lang__item {
    padding: var(--space-3xs) var(--space-2xs);
    font-size: var(--fs-caption);
    font-weight: var(--fw-medium);
    letter-spacing: var(--ls-caps-plate);
    text-transform: uppercase;
    text-decoration: none;
    /* Die inaktive Sprache ist der eigentliche Schalter, also ein Link.
       Der Entwurf setzt sie auf #9A9691 — das sind 2.65:1 auf dem
       Papier-Grund und faellt unter AA. Eine Stufe dunkler: 5.06:1. */
    color: var(--c-text-muted);
    transition: color var(--duration) var(--ease);
  }

  .lang__item:hover {
    color: var(--c-text);
  }

  /* Der aktive Zustand haengt nicht an der Farbe allein: der Entwurf
     trennt die beiden ueber einen sehr hellen Grauwert, der als Linktext
     unter AA faellt. Mit dem zulaessigen Grau ist der Farbsprung kleiner,
     darum traegt die Schriftstaerke mit. Nebeneffekt: die Unterscheidung
     bleibt auch bei Farbfehlsichtigkeit lesbar. */
  .lang__item--current {
    color: var(--c-text);
    font-weight: var(--fw-semibold);
  }
</style>
