---
import { existsSync } from 'node:fs';
import logo from '../assets/logo.svg';
import { LEGAL, pathFor, withBase, type Locale, type PageId } from '../i18n/routes';
import { useTranslations, type TranslationKey } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const projectLinks: { page: PageId; label: string }[] = [
  { page: 'lage', label: t('footer.linkLocation') },
  { page: 'architektur', label: t('footer.linkArchitecture') },
  { page: 'freiraum', label: t('footer.linkLandscape') },
  { page: 'wohnungen', label: t('footer.linkRental') },
];

// Der Planungsbericht liegt als Datei in public/, deshalb withBase. Fehlt
// die Datei, entfaellt der Eintrag — ein toter Download ist schlimmer als
// eine fehlende Zeile.
const reportFile = 'planungsbericht-gp-birkenhain.pdf';
const reportVorhanden = existsSync(new URL(`../../public/dokumente/${reportFile}`, import.meta.url));
const reportHref = withBase(`/dokumente/${reportFile}`);
---

<footer class="footer">
  <div class="footer__grid container">
    <div>
      <img class="footer__logo" src={logo.src} alt={t('site.name')} width="120" height="30" />
      <p class="footer__place">{t('footer.place')}</p>
    </div>

    <div>
      <p class="eyebrow footer__heading">{t('footer.projectHeading')}</p>
      <ul class="footer__list">
        {
          projectLinks.map((link) => (
            <li>
              <a class="footer__link" href={pathFor(link.page, locale)}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <p class="eyebrow footer__heading">{t('footer.planningHeading')}</p>
      <ul class="footer__list">
        {
          reportVorhanden && (
            <li><a class="footer__link" href={reportHref}>{t('footer.linkReport')}</a></li>
          )
        }
        <li>
          <a class="footer__link" href={pathFor('nachhaltigkeit', locale)}>
            {t('footer.linkSustainability')}
          </a>
        </li>
        <li>
          <a class="footer__link" href={`mailto:${t('anmeldung.askMail')}`}>
            {t('footer.linkQuestions')}
          </a>
        </li>
      </ul>
    </div>

    <div>
      <p class="eyebrow footer__heading">{t('footer.ownerHeading')}</p>
      <p class="footer__address">
        {t('footer.ownerName')}<br />
        {t('footer.ownerStreet')}<br />
        {t('footer.ownerCity')}
      </p>
      <a class="footer__site" href="https://www.realnorth.ch" target="_blank" rel="noopener">
        {t('footer.ownerSite')}
      </a>
    </div>
  </div>

  <div class="footer__base container">
    <p class="footer__note">{t('footer.note')}</p>
    <ul class="footer__legal">
      {
        LEGAL.map((page) => (
          <li>
            <a class="footer__legallink" href={pathFor(page, locale)}>
              {t(`nav.${page}` as TranslationKey)}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>

<style>
  .footer {
    background: var(--c-bg-inverse);
    color: var(--c-text-inverse-muted);
  }

  .footer__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12.5rem, 1fr));
    gap: var(--grid-gap);
    padding-top: clamp(3rem, 6vw, 5.5rem);
    padding-bottom: var(--space-l);
  }

  /* Das Logo ist einfarbig — invertiert ergibt es die Papier-Variante. */
  .footer__logo {
    height: 1.875rem;
    width: auto;
    filter: brightness(0) invert(1);
  }

  .footer__place {
    max-width: none;
    margin: var(--space-m) 0 0;
    font-size: 0.875rem;
    font-weight: var(--fw-light);
    line-height: var(--lh-body);
  }

  .footer__heading {
    margin: 0 0 var(--space-s);
    font-size: 0.71875rem;
    letter-spacing: var(--ls-caps-tight);
    color: var(--c-text-inverse-subtle);
  }

  .footer__list {
    display: grid;
    gap: 0.5625rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer__link,
  .footer__site {
    font-size: 0.90625rem;
    font-weight: var(--fw-light);
    color: var(--c-link-inverse);
    text-decoration: none;
  }

  .footer__link:hover,
  .footer__site:hover,
  .footer__legallink:hover {
    text-decoration: underline;
  }

  .footer__address {
    max-width: none;
    margin: 0;
    font-size: 0.90625rem;
    font-weight: var(--fw-light);
    line-height: 1.65;
    color: var(--c-link-inverse);
  }

  .footer__site {
    display: inline-block;
    margin-top: var(--space-2xs);
    color: var(--c-accent-light);
  }

  .footer__base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-s);
    padding-top: var(--space-m);
    padding-bottom: var(--space-l);
    border-top: var(--hairline-inverse);
  }

  .footer__note {
    max-width: 62ch;
    margin: 0;
    font-size: var(--fs-caption);
    font-weight: var(--fw-light);
    color: #8b877f;
  }

  .footer__legal {
    display: flex;
    gap: var(--space-m);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer__legallink {
    font-size: var(--fs-caption);
    color: #8b877f;
    text-decoration: none;
  }
</style>
