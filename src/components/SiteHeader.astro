---
import LanguageSwitch from './LanguageSwitch.astro';
import logo from '../assets/logo.svg';
import { NAV, pathFor, type Locale, type PageId } from '../i18n/routes';
import { useTranslations, type TranslationKey } from '../i18n/ui';

interface Props {
  page: PageId;
  locale: Locale;
}

const { page, locale } = Astro.props;
const t = useTranslations(locale);

// Die Anmeldung steht nicht im Menue, sondern als Button rechts.
const items = NAV.filter((id) => id !== 'anmeldung').map((id) => ({
  id,
  href: pathFor(id, locale),
  label: t(`nav.${id}` as TranslationKey),
  current: id === page,
}));
---

<header class="header">
  <div class="header__inner container">
    <a class="brand" href={pathFor('home', locale)} aria-label={t('site.name')}>
      <img src={logo.src} alt={t('site.name')} width="120" height="30" />
    </a>

    <nav class="nav" aria-label={t('nav.label')}>
      <ul class="nav__list">
        {
          items.map((item) => (
            <li>
              <a class="nav__link" href={item.href} aria-current={item.current ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header__aside">
      <LanguageSwitch page={page} locale={locale} />
      <a class="btn btn--primary btn--compact header__cta" href={pathFor('anmeldung', locale)}>
        {t('nav.cta')}
      </a>
      <button class="burger" type="button" aria-expanded="false" aria-controls="mobile-nav" data-burger>
        <span class="visually-hidden" data-burger-open>{t('nav.menuOpen')}</span>
        <span class="visually-hidden" data-burger-close hidden>{t('nav.menuClose')}</span>
        <span class="burger__bars" aria-hidden="true"><span></span><span></span></span>
      </button>
    </div>
  </div>

  <nav class="mobile" id="mobile-nav" aria-label={t('nav.label')} hidden>
    <ul class="mobile__list container">
      {
        items.map((item) => (
          <li>
            <a class="mobile__link" href={item.href} aria-current={item.current ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  /* Durchscheinender Grund mit Blur: der Header liegt ueber dem Hero-Bild. */
  .header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    background: rgb(245 243 238 / 0.94);
    backdrop-filter: blur(16px);
    border-bottom: var(--hairline);
  }

  .header__inner {
    display: flex;
    align-items: center;
    gap: clamp(0.875rem, 2.4vw, 2.5rem);
    min-height: var(--header-h);
  }

  .brand {
    flex: 0 0 auto;
    display: block;
    line-height: 0;
  }

  .brand img {
    height: 1.875rem;
    width: auto;
  }

  .nav {
    display: none;
    margin-left: auto;
    min-width: 0;
  }

  .nav__list {
    display: flex;
    align-items: center;
    gap: clamp(0.5rem, 1.5vw, 1.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav__link {
    display: inline-block;
    padding-block: var(--space-3xs);
    font-size: 0.875rem;
    font-weight: var(--fw-regular);
    color: #5c5852;
    text-decoration: none;
    border-bottom: var(--border-width) solid transparent;
    transition:
      color var(--duration) var(--ease),
      border-color var(--duration) var(--ease);
  }

  .nav__link:hover {
    color: var(--c-text);
  }

  .nav__link[aria-current='page'] {
    color: var(--c-text);
    border-bottom-color: var(--c-accent);
  }

  .header__aside {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    margin-left: auto;
  }

  .nav + .header__aside {
    margin-left: 0;
    padding-left: var(--space-2xs);
    border-left: var(--hairline);
  }

  .header__cta {
    display: none;
  }

  .burger {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border: var(--hairline);
  }

  .burger__bars {
    display: grid;
    gap: 5px;
    width: 1.125rem;
  }

  .burger__bars > span {
    display: block;
    height: var(--border-width);
    background: var(--c-text);
  }

  .mobile {
    border-top: var(--hairline);
  }

  .mobile__list {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding-block: var(--space-2xs);
    list-style: none;
  }

  .mobile__link {
    display: block;
    padding-block: var(--space-xs);
    border-bottom: var(--hairline);
    text-decoration: none;
  }

  .mobile__list > li:last-child .mobile__link {
    border-bottom: 0;
  }

  @media (min-width: 48rem) {
    .header__cta {
      display: inline-flex;
    }
  }

  @media (min-width: 60rem) {
    .nav {
      display: block;
    }

    .burger,
    .mobile {
      display: none;
    }
  }
</style>

<script>
  const burger = document.querySelector<HTMLButtonElement>('[data-burger]');
  const panel = document.getElementById('mobile-nav');

  if (burger && panel) {
    const openLabel = burger.querySelector<HTMLElement>('[data-burger-open]');
    const closeLabel = burger.querySelector<HTMLElement>('[data-burger-close]');

    const setOpen = (open: boolean) => {
      burger.setAttribute('aria-expanded', String(open));
      panel.hidden = !open;
      if (openLabel) openLabel.hidden = open;
      if (closeLabel) closeLabel.hidden = !open;
    };

    burger.addEventListener('click', () => {
      setOpen(burger.getAttribute('aria-expanded') !== 'true');
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && burger.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        burger.focus();
      }
    });
  }
</script>
