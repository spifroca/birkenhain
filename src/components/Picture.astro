---
import { Picture as AstroPicture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/** Die im Briefing festgelegten Breiten. Grössere Stufen als das Original
    lässt Astro weg, es wird nichts hochskaliert. */
const WIDTHS = [640, 1024, 1600, 2000] as const;

interface Props {
  src: ImageMetadata;
  alt: string;
  /** `sizes` muss zum Layout passen, sonst nützt srcset nichts. */
  sizes?: string;
  /** Nur das Hero-Bild einer Seite lädt eager. */
  hero?: boolean;
  class?: string;
  ratio?: string;
}

const {
  src,
  alt,
  sizes = '(min-width: 82.5rem) 82.5rem, 100vw',
  hero = false,
  class: className,
  ratio,
} = Astro.props;
---

<figure class:list={['picture', className]} style={ratio ? `--ratio: ${ratio}` : undefined}>
  <AstroPicture
    src={src}
    alt={alt}
    widths={[...WIDTHS]}
    sizes={sizes}
    formats={['avif', 'webp']}
    fallbackFormat="jpg"
    loading={hero ? 'eager' : 'lazy'}
    decoding={hero ? 'sync' : 'async'}
    fetchpriority={hero ? 'high' : 'auto'}
  />
  <slot />
</figure>

<style>
  .picture {
    margin: 0;
    background: var(--c-bg-alt);
  }

  .picture :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    aspect-ratio: var(--ratio, auto);
  }

  .picture :global(figcaption) {
    padding-top: var(--space-2xs);
    font-size: var(--fs-small);
    color: var(--c-text-muted);
  }
</style>
