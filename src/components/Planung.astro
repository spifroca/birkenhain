---
import { existsSync } from 'node:fs';
import Icon from './Icon.astro';
import { withBase, type Locale } from '../i18n/routes';
import { useTranslations, type TranslationKey } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

/**
 * Die Unterlagen liegen als Datei in `public/dokumente/`. Fehlt eine, bleibt
 * die Zeile stehen, aber ohne Link — ein toter Download ist schlimmer als
 * eine sichtbare Luecke.
 */
const downloads = [
  { label: t('home.dl1'), meta: t('home.dl1Meta'), file: 'planungsbericht-gp-birkenhain.pdf' },
  { label: t('home.dl2'), meta: t('home.dl2Meta'), file: 'situationsplan-1-500.pdf' },
  { label: t('home.dl3'), meta: t('home.dl3Meta'), file: 'sondernutzungsvorschriften.pdf' },
].map((item) => ({
  ...item,
  // Zur Buildzeit geprueft: liegt die Datei nicht in public/dokumente/,
  // bleibt die Zeile ohne Link stehen.
  vorhanden: existsSync(new URL(`../../public/dokumente/${item.file}`, import.meta.url)),
}));

/**
 * Logos der Beteiligten unter den Unterlagen.
 *
 * Sie liegen in `public/logos/`, nicht in `src/assets/`: an Vektoren hat
 * astro:assets nichts zu optimieren, und aus `public/` bricht der Build
 * nicht ab, wenn eine Datei fehlt — sie wird dann einfach nicht gerendert.
 * Genauso wie bei den PDFs oben: eine sichtbare Luecke ist besser als ein
 * defektes Element. Sobald die Datei liegt, erscheint sie von selbst.
 *
 * `rudolfstetten.png` ist die eine Ausnahme von der SVG-Regel: die Gemeinde
 * fuehrt ihr Logo nur als Pixelgrafik (325x99), und ein nachgezeichnetes
 * Wappen waere eine Verfaelschung. 99 px Quellhoehe decken die 44 px
 * Anzeigehoehe bis Retina-2x.
 */
const PARTNER_LOGOS = [
  { file: 'suisse-plan.svg', alt: t('home.planungPartner'), width: 86 },
  { file: 'rudolfstetten.png', alt: t('home.planungGemeinde'), width: 144 },
];
const partnerLogos = PARTNER_LOGOS.filter((logo) =>
  existsSync(new URL(`../../public/logos/${logo.file}`, import.meta.url)),
).map((logo) => ({ ...logo, src: withBase(`/logos/${logo.file}`) }));

/**
 * Acht Stationen, aus dem Woerterbuch. Rueckt der Gestaltungsplan weiter,
 * ist AKTUELL die einzige Zahl, die mitwandern muss — das Abzeichen hing
 * vorher am Schluesselnamen und damit fest an einer Station.
 */
const STATIONEN = 8;
const AKTUELL = 6;

const timeline = Array.from({ length: STATIONEN }, (_, i) => {
  const n = i + 1;
  return {
    time: t(`home.tl${n}Time` as TranslationKey),
    text: t(`home.tl${n}` as TranslationKey),
    badge: n === AKTUELL ? t('home.tlBadge') : undefined,
  };
});
---

<section class="planung section" aria-labelledby="planung-heading">
  <div class="container cols" data-reveal>
    <div>
      <p class="kicker">{t('home.planungKicker')}</p>
      <h2 id="planung-heading">{t('home.planungTitle')}</h2>
      <p class="planung__body">{t('home.planungBody')}</p>

      <ul class="downloads">
        {
          downloads.map((item) =>
            item.vorhanden ? (
              <li>
                <a class="download" href={withBase(`/dokumente/${item.file}`)}>
                  <span>
                    <span class="download__label">{item.label}</span>
                    <span class="download__meta">{item.meta}</span>
                  </span>
                  <span class="download__icon"><Icon name="arrow-down" /></span>
                </a>
              </li>
            ) : (
              <li>
                <span class="download download--pending">
                  <span>
                    <span class="download__label">{item.label}</span>
                    <span class="download__meta">{item.meta}</span>
                  </span>
                </span>
              </li>
            ),
          )
        }
      </ul>

      {
        partnerLogos.length > 0 && (
          <p class="planung__partner">
            {partnerLogos.map((logo) => (
              <img
                src={logo.src}
                alt={logo.alt}
                width={logo.width}
                height="44"
                loading="lazy"
                decoding="async"
              />
            ))}
          </p>
        )
      }
    </div>

    <ol class="timeline">
      {
        timeline.map((step) => (
          <li class:list={['timeline__step', step.badge && 'timeline__step--now']}>
            <span class="timeline__time">{step.time}</span>
            <span>
              <span class="timeline__text">{step.text}</span>
              {step.badge && <span class="timeline__badge">{step.badge}</span>}
            </span>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  /* Logo des Planungsbueros: klein, unten links, mit Luft zu den
     Unterlagen. Hoehe fest, Breite automatisch — so bleibt das
     Seitenverhaeltnis erhalten, was auch immer die Datei mitbringt. */
  .planung__partner {
    display: flex;
    align-items: center;
    gap: var(--space-l);
    max-width: none;
    margin: var(--space-l) 0 0;
  }

  .planung__partner img {
    display: block;
    width: auto;
    height: 2.75rem;
  }

  .planung h2 {
    margin-bottom: var(--space-m);
    line-height: 1.08;
  }

  .planung__body {
    max-width: 44ch;
    margin: 0;
    font-size: var(--fs-body);
    font-weight: var(--fw-light);
    line-height: var(--lh-body);
    color: #54514d;
  }

  .downloads {
    display: grid;
    gap: var(--border-width);
    margin: var(--space-l) 0 0;
    padding: 0;
    list-style: none;
    background: var(--c-hairline);
    border: var(--hairline);
  }

  .download {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-m);
    padding: var(--space-s) 1.125rem;
    background: var(--c-bg);
    color: var(--c-text);
    text-decoration: none;
  }

  .download:hover {
    background: var(--c-bg-alt);
  }

  /* Ohne Datei: die Zeile bleibt sichtbar, gibt sich aber nicht als Link
     aus — kein Zeiger, kein Hover, gedaempft. */
  .download--pending {
    color: var(--c-text-muted);
  }

  .download--pending:hover {
    background: var(--c-bg);
  }

  .download__label {
    display: block;
    font-size: var(--fs-small);
    font-weight: var(--fw-regular);
  }

  .download__meta {
    display: block;
    margin-top: 3px;
    font-size: var(--fs-caption);
    color: var(--c-text-subtle);
  }

  .download__icon {
    flex: 0 0 auto;
    color: var(--c-accent);
  }

  /* --- Zeitachse --------------------------------------------------------- */

  .timeline {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .timeline__step {
    display: grid;
    grid-template-columns: 6rem 1fr;
    gap: var(--space-m);
    padding-block: 1.125rem;
    border-top: var(--hairline);
  }

  .timeline__step:last-child {
    border-bottom: var(--hairline);
  }

  /* Der aktuelle Stand ist die einzige Zeile mit Flaeche. */
  .timeline__step--now {
    background: linear-gradient(90deg, rgb(74 90 68 / 0.09), transparent 62%);
  }

  .timeline__time {
    font-size: var(--fs-caption);
    font-weight: var(--fw-medium);
    letter-spacing: 0.06em;
    color: var(--c-text-subtle);
  }

  .timeline__step--now .timeline__time {
    color: var(--c-accent);
  }

  .timeline__text {
    font-size: var(--fs-small);
    font-weight: var(--fw-light);
    line-height: 1.5;
    color: #54514d;
  }

  .timeline__step--now .timeline__text {
    font-weight: var(--fw-regular);
    color: var(--c-text);
  }

  .timeline__badge {
    display: block;
    margin-top: var(--space-3xs);
    font-size: var(--fs-caption);
    font-weight: var(--fw-bold);
    letter-spacing: var(--ls-caps-tight);
    text-transform: uppercase;
    color: var(--c-accent);
  }
</style>
