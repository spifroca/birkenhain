---
import Picture from './Picture.astro';
import type { ImageMetadata } from 'astro';

export interface TeaserItem {
  href: string;
  title: string;
  text: string;
  image: ImageMetadata;
  alt: string;
}

interface Props {
  items: TeaserItem[];
}

const { items } = Astro.props;
---

<section class="teaser container">
  <ul class="teaser__grid" data-reveal>
    {
      items.map((item) => (
        <li>
          <a class="teaser__link" href={item.href}>
            <Picture
              src={item.image}
              alt={item.alt}
              ratio="4 / 3"
              sizes="(min-width: 68rem) 25vw, (min-width: 45rem) 50vw, 100vw"
            />
            <h3 class="teaser__title">{item.title}</h3>
            <p class="teaser__text">{item.text}</p>
          </a>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .teaser {
    padding-bottom: clamp(3.5rem, 8vw, 6.875rem);
  }

  .teaser__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(var(--col-min), 1fr));
    gap: var(--grid-gap-tight);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .teaser__link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .teaser__link :global(.picture) {
    transition: opacity var(--duration) var(--ease);
  }

  .teaser__link:hover :global(.picture) {
    opacity: 0.9;
  }

  .teaser__title {
    margin: var(--space-s) 0 var(--space-2xs);
    font-size: 1.3125rem;
    font-weight: var(--fw-regular);
    letter-spacing: var(--ls-heading);
  }

  .teaser__link:hover .teaser__title {
    color: var(--c-accent);
  }

  .teaser__text {
    max-width: none;
    margin: 0;
    font-size: var(--fs-small);
    font-weight: var(--fw-light);
    line-height: var(--lh-body-tight);
    color: var(--c-text-muted);
  }
</style>
