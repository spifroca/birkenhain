---
import { useTranslations, formatNumber } from '../i18n/ui';
import { projekt } from '../lib/projekt';
import type { Locale } from '../i18n/routes';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

// Fuenf Kennzahlen wie im Entwurf. Zahlen aus projekt.json, wo sie dort
// stehen — im Markup steht keine.
const facts = [
  { value: formatNumber(projekt.wohnungen, locale), label: t('facts.wohnungen') },
  { value: t('facts.zimmerValue'), label: t('facts.zimmer') },
  { value: formatNumber(projekt.baubereiche, locale), label: t('facts.haeuser') },
  ...(projekt.oberirdischAutofrei
    ? [{ value: t('facts.autofreiValue'), label: t('facts.autofrei') }]
    : []),
  { value: t('facts.oevValue'), label: t('facts.oev') },
];
---

<section class="fakten section--alt" aria-labelledby="fakten-heading">
  <div class="container">
    <h2 class="visually-hidden" id="fakten-heading">{t('facts.heading')}</h2>
    <dl class="stats">
      {
        facts.map((fact) => (
          <div class="stat">
            <dt class="stat__label">{fact.label}</dt>
            <dd class="stat__value">{fact.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  /* Das Band traegt seine Linien selbst: die Trennstriche stehen zwischen
     den Zellen, nicht als Umrandung. */
  .fakten {
    border-top: 0;
  }

  /* dt steht im Markup zuerst — im Bild steht die Zahl oben. */
  .stat {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    padding-block: 1.625rem;
  }

  .stat dd {
    margin: 0;
  }
</style>
