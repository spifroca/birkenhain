---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BaubereicheTabelle from '../BaubereicheTabelle.astro';
import Galerie from '../Galerie.astro';
import Hero from '../Hero.astro';
import { useTranslations } from '../../i18n/ui';
import type { Locale } from '../../i18n/routes';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<BaseLayout
  page="architektur"
  locale={locale}
  title={t('architektur.metaTitle')}
  description={t('architektur.metaDescription')}
>
  <Hero title={t('architektur.title')} lead={t('architektur.lead')} />
  <BaubereicheTabelle locale={locale} />
  <Galerie locale={locale} />
</BaseLayout>
