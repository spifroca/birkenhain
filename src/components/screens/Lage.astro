---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DistanzTabelle from '../DistanzTabelle.astro';
import Hero from '../Hero.astro';
import Karte from '../Karte.astro';
import { getEntry } from 'astro:content';
import { pick, useTranslations } from '../../i18n/ui';
import type { Locale } from '../../i18n/routes';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

// Alt-Text und optimiertes Bild kommen aus dem Galerie-Datensatz,
// damit die Legende nicht doppelt gepflegt wird.
const aerial = await getEntry('galerie', 'aerial.jpg');
---

<BaseLayout
  page="lage"
  locale={locale}
  title={t('lage.metaTitle')}
  description={t('lage.metaDescription')}
>
  <Hero
    eyebrow={t('lage.kicker')}
    title={t('lage.title')}
    lead={t('lage.lead')}
    image={aerial?.data.src}
    imageAlt={aerial && pick(aerial.data.alt, locale)}
  />
  <DistanzTabelle locale={locale} />
  <Karte locale={locale} />
</BaseLayout>
