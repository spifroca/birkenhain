---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Fakten from '../Fakten.astro';
import Galerie from '../Galerie.astro';
import Hero from '../Hero.astro';
import Situationsplan from '../Situationsplan.astro';
import { getCollection } from 'astro:content';
import { pick, useTranslations } from '../../i18n/ui';
import type { Locale } from '../../i18n/routes';
import situationsplan from '../../assets/situationsplan.png';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

// Genau ein Galerie-Eintrag traegt `hero: true`; der laedt eager.
const heroBild = (await getCollection('galerie')).find((entry) => entry.data.hero);
---

<BaseLayout
  page="home"
  locale={locale}
  title={t('home.metaTitle')}
  description={t('home.metaDescription')}
>
  <Hero
    eyebrow={t('home.kicker')}
    title={t('home.heroTitle')}
    lead={t('home.heroLead')}
    image={heroBild?.data.src}
    imageAlt={heroBild && pick(heroBild.data.alt, locale)}
  />
  <Fakten locale={locale} />
  <Situationsplan locale={locale} plan={situationsplan} />
  <Galerie locale={locale} limit={6} />
</BaseLayout>
