{
  "name": "birkenhain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "check:data": "node scripts/check-data.mjs",
    "check:browser": "node scripts/browser-check.mjs",
    "fonts": "node scripts/fetch-fonts.mjs",
    "format": "prettier --write .",
    "check:php": "find public/api -name \"*.php\" -print0 | xargs -0 -n1 php -l",
    "test:endpoint": "./scripts/test-endpoint.sh",
    "check:csp": "node scripts/check-csp.mjs",
    "check:live-headers": "bash scripts/check-live-headers.sh"
  },
  "dependencies": {
    "astro": "^5.6.1",
    "leaflet": "^1.9.4",
    "lucide-static": "^0.487.0",
    "sharp": "^0.34.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@types/leaflet": "^1.9.17",
    "@types/node": "^22.14.0",
    "prettier": "^3.5.3",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.8.3"
  }
}
