{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    // Workers-Runtime: hier kommen PagesFunction, KVNamespace und die
    // uebrigen Cloudflare-Globals her.
    "types": ["@cloudflare/workers-types"],
    "lib": ["ES2022", "WebWorker"],
    "moduleResolution": "bundler",
    "module": "ESNext",
    "target": "ES2022",
    "noEmit": true
  },
  "include": ["**/*.ts"],
  // Muss gesetzt sein: sonst erbt diese Config das "functions" aus der
  // Eltern-Config, relativ zum Repo-Root aufgeloest — und pruefte nichts.
  "exclude": []
}
